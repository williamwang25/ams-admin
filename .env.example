# AMS 管理端环境变量模板
# 克隆仓库后，复制本文件为 .env.local 并填入实际值
# .env.local 已加入 .gitignore，请勿将真实值提交到 git

# ── CloudBase 环境 ID ─────────────────────────────────────────────────────
# 在 CloudBase 控制台 -> 环境 -> 概览 中查看
ENV_ID=ams-xxxxxxxxxx
VITE_ENV_ID=ams-xxxxxxxxxx

# ── CloudBase Publishable Key（匿名登录令牌）──────────────────────────────
# 在 CloudBase 控制台 -> 环境 -> 安全配置 -> WEB 安全域名 / Publishable Key 中查看
# 注意：此 Key 为客户端可见，但请勿公开到公共 issue 或截图中
VITE_PUBLISHABLE_KEY=eyJ...
