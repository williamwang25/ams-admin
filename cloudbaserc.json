{
  "version": "2.0",
  "envId": "{{env.ENV_ID}}",
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "app": {
    "buildCommand": "npm run build",
    "outputDir": "dist",
    "deployPath": "/"
  },
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "auth",
      "timeout": 10,
      "memorySize": 128,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false,
      "envVariables": {}
    }
  ],
  "region": "ap-shanghai"
}
